{
  "name": "frameit",
  "version": "0.1.0",
  "description": "A lightweight, open-source image generator for creating beautiful title images—thumbnails, OG images, and title cards—across multiple platforms",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --ext ts,tsx,astro --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx,astro --fix",
    "type-check": "astro check && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:e2e:chrome": "playwright test --project=chromium"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.12",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^9.0.1",
    "@goodideadev/react": "^2.0.0",
    "@headlessui/react": "^2.2.9",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@vercel/analytics": "^1.5.0",
    "astro": "^5.16.0",
    "lucide-react": "^0.553.0",
    "posthog-js": "^1.292.0",
    "react": "^19.0.0-rc.1",
    "react-dom": "^19.0.0-rc.1",
    "react-dropzone": "^14.3.8",
    "satori": "^0.18.3",
    "simple-icons": "^15.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vercel/node": "^5.5.5",
    "@vitejs/plugin-react": "^4.2.0",
    "astro-eslint-parser": "^1.2.2",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "lighthouse": "^13.0.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "vite": "^5.0.8"
  }
}
